# Keycloak OIDC Authentication Configuration Example
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=passon-ride
KEYCLOAK_CLIENT_ID=passon-ride-app
KEYCLOAK_CLIENT_SECRET=

# Inngest Event & Signing Keys Example
INNGEST_EVENT_KEY=your_inngest_event_key_here
INNGEST_SIGNING_KEY=your_inngest_signing_key_here

# ImageKit.io Free Media Storage CDN Example
IMAGEKIT_PUBLIC_KEY=public_your_imagekit_public_key
IMAGEKIT_PRIVATE_KEY=private_your_imagekit_private_key
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id

# Supabase Database & Auth Service Example
SUPABASE_URL=https://your_supabase_project_id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
